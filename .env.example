# ══════════════════════════════════════════════════════════════
# DecentAI Protocol — Environment Configuration
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in every REQUIRED value.
# OPTIONAL values have working defaults shown.
# Never commit .env to source control.
# ══════════════════════════════════════════════════════════════


# ── Chain / RPC ──────────────────────────────────────────────
# REQUIRED: Arc Testnet RPC endpoint
ARC_RPC_URL=https://rpc.testnet.arc.network

# REQUIRED: Arc chain ID (do not change for testnet)
CHAIN_ID=5042002

# OPTIONAL: USD price of ARC gas token (used for fee display only)
ARC_USD_PRICE=0.01


# ── Contracts ────────────────────────────────────────────────
# REQUIRED after deploy: address of deployed DecentAIInference.sol
CONTRACT_ADDRESS=0x...

# REQUIRED after deploy: address of deployed ModelRegistry.sol
REGISTRY_ADDRESS=0x...


# ── Node wallet ──────────────────────────────────────────────
# REQUIRED: private key of the wallet the router uses to submit
# chargeInference() transactions. This wallet must be registered
# as a node via registerNode() on the contract.
# Generate a fresh wallet: cd contracts && npm run wallet
NODE_PRIVATE_KEY=0x...

# REQUIRED for deploy scripts: private key of the deployer wallet
# Can be the same as NODE_PRIVATE_KEY on testnet.
DEPLOYER_PRIVATE_KEY=0x...


# ── GPU Node endpoints ───────────────────────────────────────
# Add as many nodes as you have. Index from 1.
# NODE_n_ADDRESS  = the on-chain wallet address registered for that node
# NODE_n_ENDPOINT = the HTTP endpoint of the Ollama instance on that node

NODE_1_ADDRESS=0x...
NODE_1_ENDPOINT=http://YOUR_GPU_IP:11434

# NODE_2_ADDRESS=0x...
# NODE_2_ENDPOINT=http://YOUR_SECOND_GPU:11434


# ── Router behaviour ─────────────────────────────────────────
# Per-wallet rate limit (requests per minute)
RATE_LIMIT_RPM=60

# How often to re-sync node bids from ModelRegistry (seconds)
REGISTRY_SYNC_INTERVAL=60

# Markup multipliers per model tier (1.0 = no markup)
ROUTER_MARKUP_STANDARD=1.0
ROUTER_MARKUP_PERFORMANCE=1.0
ROUTER_MARKUP_PREMIUM=1.0


# ── OpenAI fallback proxy ────────────────────────────────────
# Set OPENAI_FALLBACK=true to enable GPT-4o / Claude Haiku proxy
OPENAI_FALLBACK=false
OPENAI_API_KEY=sk-...
# On-chain wallet address used for billing OpenAI proxy calls
OPENAI_NODE_ADDRESS=0x...


# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
